# Copia este archivo como .env.local y rellena con los datos de tu proyecto:
# Supabase → Project Settings → API (o el botón "Connect").
# Sin estas variables la app funciona en modo local (solo en este navegador).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# Nombre de tu pareja, para los textos ("Para ti y …"). Opcional.
# VITE_PARTNER_NAME=
